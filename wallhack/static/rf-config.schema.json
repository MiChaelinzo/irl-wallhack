{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wallhack:rf-config.schema",
  "title": "wallhack rf-config.json",
  "description": "Structure of the shared RF configuration. Covers bands, materials, kind_defaults, floor_loss_db and wifi_standards. Other sections are allowed and validated by the engine tests.",
  "type": "object",
  "required": ["schema_version", "label", "source", "bands", "materials", "kind_defaults", "floor_loss_db", "wifi_standards",
    "floor_elevation", "ap_profiles", "client_devices", "capacity_models"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "label": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "bands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/band"}
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/material"}
    },
    "kind_defaults": {
      "type": "object",
      "required": ["interior", "exterior"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "floor_loss_db": {"$ref": "#/$defs/perBandNumber"},
    "wall_thickness": {
      "type": "object",
      "required": ["label", "source", "min_cm", "max_cm", "max_factor", "default_reference_cm", "reference_cm"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "min_cm": {"type": "number", "exclusiveMinimum": 0},
        "max_cm": {"type": "number", "exclusiveMinimum": 0},
        "max_factor": {"type": "number", "minimum": 1},
        "default_reference_cm": {"type": "number", "exclusiveMinimum": 0},
        "reference_cm": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "objects": {
      "type": "object",
      "required": ["label", "source", "kinds"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "kinds": {"type": "object", "minProperties": 1, "additionalProperties": {
          "type": "object", "required": ["label", "material", "thickness_cm", "w_m", "d_m"],
          "properties": {"label": {"type": "string"}, "material": {"type": "string"}, "thickness_cm": {"type": "number", "exclusiveMinimum": 0},
                         "w_m": {"type": "number", "exclusiveMinimum": 0}, "d_m": {"type": "number", "exclusiveMinimum": 0}}}}
      }
    },
    "insight": {
      "type": "object",
      "required": ["label", "source", "gaming", "streaming", "video", "rating_words", "score_card", "mesh", "time_machine", "assistant"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "gaming": {
          "type": "object",
          "required": ["isp_base_ms", "round_trip_factor", "range_low_percentile", "range_high_percentile", "min_range_ms", "airtime_jitter_ms", "loss_risk",
                       "ping_full_ms", "ping_zero_ms", "jitter_full_ms", "jitter_zero_ms", "loss_full_pct", "loss_zero_pct", "per_full_pct", "per_zero_pct",
                       "margin_full_db", "margin_zero_db", "weights", "grades"],
          "properties": {
            "isp_base_ms": {"type": "number", "minimum": 0}, "round_trip_factor": {"type": "number", "exclusiveMinimum": 0},
            "range_low_percentile": {"type": "number", "minimum": 0, "maximum": 100}, "range_high_percentile": {"type": "number", "minimum": 0, "maximum": 100},
            "min_range_ms": {"type": "number", "minimum": 0}, "airtime_jitter_ms": {"type": "number", "minimum": 0},
            "loss_risk": {"type": "object", "required": ["low_max_loss_pct", "medium_max_loss_pct", "low_max_per_pct", "medium_max_per_pct"],
                          "additionalProperties": {"type": "number", "minimum": 0}},
            "ping_full_ms": {"type": "number"}, "ping_zero_ms": {"type": "number"}, "jitter_full_ms": {"type": "number"}, "jitter_zero_ms": {"type": "number"},
            "loss_full_pct": {"type": "number"}, "loss_zero_pct": {"type": "number"}, "per_full_pct": {"type": "number"}, "per_zero_pct": {"type": "number"},
            "margin_full_db": {"type": "number"}, "margin_zero_db": {"type": "number"},
            "weights": {"type": "object", "required": ["ping", "jitter", "loss", "margin"], "additionalProperties": {"type": "number", "minimum": 0}},
            "grades": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["grade", "min_score"], "properties": {"grade": {"type": "string", "minLength": 1}, "min_score": {"type": "number", "minimum": 0, "maximum": 100}}}}
          }
        },
        "streaming": {"type": "object", "required": ["stream_mbps", "target_streams", "throughput_percentile"],
                      "properties": {"stream_mbps": {"type": "number", "exclusiveMinimum": 0}, "target_streams": {"type": "integer", "minimum": 1}, "throughput_percentile": {"type": "number", "minimum": 0, "maximum": 100}}},
        "video": {"type": "object", "required": ["min_mbps", "ping_full_ms", "ping_zero_ms", "loss_full_pct", "loss_zero_pct"],
                  "additionalProperties": {"type": "number"}},
        "rating_words": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["word", "min_score"],
                         "properties": {"word": {"type": "string", "minLength": 1}, "min_score": {"type": "number", "minimum": 0, "maximum": 100}}}},
        "score_card": {"type": "object", "required": ["weights", "dead_zone_count_zero", "sinr_full_db", "sinr_zero_db", "grades"],
                       "properties": {"weights": {"type": "object", "required": ["coverage", "dead_zones", "sinr", "activities"], "additionalProperties": {"type": "number", "minimum": 0}},
                                      "dead_zone_count_zero": {"type": "integer", "minimum": 1}, "sinr_full_db": {"type": "number"}, "sinr_zero_db": {"type": "number"}, "grades": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["grade", "min_score"], "properties": {"grade": {"type": "string", "minLength": 1}, "min_score": {"type": "number", "minimum": 0, "maximum": 100}}}}}},
        "mesh": {"type": "object", "required": ["max_nodes", "rooms_per_node", "hop_latency_ms"],
                 "properties": {"max_nodes": {"type": "integer", "minimum": 1}, "rooms_per_node": {"type": "integer", "minimum": 1}, "hop_latency_ms": {"type": "number", "minimum": 0}}},
        "time_machine": {"type": "object", "required": ["min_items", "max_items", "presets"],
                         "properties": {"min_items": {"type": "integer", "minimum": 2}, "max_items": {"type": "integer", "minimum": 2},
                                        "presets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "profile_id", "mesh_profile_id"],
                                          "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1}}}}}},
        "assistant": {"type": "object", "required": ["intents", "worst_cell_intents", "devices", "stopwords", "move_steps_m", "max_fixes", "mesh_candidates",
                                                     "busy_cause_min_pct", "min_cause_db", "interference_min_db", "label_zone_m"],
                      "properties": {"intents": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
                                     "worst_cell_intents": {"type": "array", "items": {"type": "string"}}, "devices": {"type": "array", "items": {"type": "string"}},
                                     "stopwords": {"type": "array", "items": {"type": "string"}},
                                     "move_steps_m": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}, "max_fixes": {"type": "integer", "minimum": 1},
                                     "mesh_candidates": {"type": "integer", "minimum": 1}, "busy_cause_min_pct": {"type": "number", "minimum": 0},
                                     "min_cause_db": {"type": "number", "minimum": 0}, "interference_min_db": {"type": "number", "minimum": 0}, "label_zone_m": {"type": "number", "exclusiveMinimum": 0}}}
      }
    },
    "floor_elevation": {
      "type": "object",
      "required": ["label", "source", "reference_height_m", "elevation_m_range"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "reference_height_m": {"type": "number", "exclusiveMinimum": 0},
        "elevation_m_range": {"$ref": "#/$defs/numberRange"}
      },
      "additionalProperties": false
    },
    "ap_profiles": {
      "type": "object",
      "required": ["label", "source", "eirp_limit_dbm", "profiles"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "eirp_limit_dbm": {
          "type": "object",
          "required": ["etsi", "fcc"],
          "additionalProperties": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/apProfile"}
        }
      },
      "additionalProperties": false
    },
    "client_devices": {
      "type": "object",
      "required": ["label", "source", "devices"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "devices": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["label", "demand_mbps", "bands"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "demand_mbps": {"type": "number", "exclusiveMinimum": 0},
              "bands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capacity_models": {
      "type": "object",
      "required": ["label", "source", "ofdma", "mu_mimo", "beamforming"],
      "properties": {
        "label": {"type": "string", "pattern": "^CAPACITY MODEL"},
        "source": {"type": "string", "minLength": 1},
        "ofdma": {
          "type": "object",
          "required": ["gain_by_standard", "saturation_clients"],
          "properties": {
            "gain_by_standard": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
            "saturation_clients": {"type": "integer", "minimum": 2}
          },
          "additionalProperties": false
        },
        "mu_mimo": {
          "type": "object",
          "required": ["max_users_by_standard", "spatial_efficiency"],
          "properties": {
            "max_users_by_standard": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "spatial_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "beamforming": {
          "type": "object",
          "required": ["standards", "array_gain_db_per_doubling", "steering_efficiency", "max_gain_db"],
          "properties": {
            "standards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "array_gain_db_per_doubling": {"type": "number", "minimum": 0},
            "steering_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "max_gain_db": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wifi_standards": {
      "type": "object",
      "required": ["label", "source", "default_streams", "default_guard_interval_us", "mcs", "standards"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "default_streams": {"type": "integer", "minimum": 1},
        "default_guard_interval_us": {"type": "number", "exclusiveMinimum": 0},
        "mcs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "modulation", "bits_per_subcarrier", "coding_rate", "min_snr_db"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "modulation": {"type": "string", "minLength": 1},
              "bits_per_subcarrier": {"type": "integer", "minimum": 1},
              "coding_rate": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
              "min_snr_db": {"type": "number"}
            }
          }
        },
        "standards": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["label", "ieee", "max_streams", "max_mcs", "symbol_us", "guard_intervals_us", "data_subcarriers", "widths_mhz_by_band"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "ieee": {"type": "string", "minLength": 1},
              "max_streams": {"type": "integer", "minimum": 1},
              "max_mcs": {"type": "integer", "minimum": 0},
              "symbol_us": {"type": "number", "exclusiveMinimum": 0},
              "guard_intervals_us": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
              "data_subcarriers": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "widths_mhz_by_band": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "numberRange": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "apProfile": {
      "type": "object",
      "required": ["label", "description", "standard", "band", "bands", "spatial_streams", "tx_dbm", "antenna_gain_dbi", "pattern", "beamforming", "confidence"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "standard": {"type": "string", "minLength": 1},
        "band": {"type": "string", "minLength": 1},
        "bands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "spatial_streams": {"type": "integer", "minimum": 1},
        "tx_dbm": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 30}},
        "antenna_gain_dbi": {"type": "number"},
        "pattern": {"type": "string", "minLength": 1},
        "beamforming": {"type": "boolean"},
        "confidence": {"enum": ["low", "medium", "high"]}
      },
      "additionalProperties": false
    },
    "perBandNumber": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 80}
    },
    "band": {
      "type": "object",
      "required": ["ghz", "pl0_db", "path_loss_exponent", "channels", "default_channel", "default_width_mhz", "widths_mhz"],
      "properties": {
        "ghz": {"type": "number", "exclusiveMinimum": 0},
        "pl0_db": {"type": "number"},
        "path_loss_exponent": {"type": "number", "exclusiveMinimum": 0},
        "channels": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "default_channel": {"type": "integer", "minimum": 1},
        "default_width_mhz": {"type": "integer", "minimum": 1},
        "widths_mhz": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "range": {
      "type": "object",
      "required": ["min", "typical", "max"],
      "properties": {
        "min": {"type": "number", "minimum": 0, "maximum": 80},
        "typical": {"type": "number", "minimum": 0, "maximum": 80},
        "max": {"type": "number", "minimum": 0, "maximum": 80}
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["label", "attenuation_db", "reflection_loss_db", "range_db", "frequency_exponent", "confidence", "simulation_cost", "sources", "notes"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "attenuation_db": {"$ref": "#/$defs/perBandNumber"},
        "reflection_loss_db": {"$ref": "#/$defs/perBandNumber"},
        "range_db": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/range"}},
        "frequency_exponent": {"type": "number", "minimum": 0},
        "confidence": {"enum": ["low", "medium", "high"]},
        "simulation_cost": {"enum": ["wall_segment", "reference_slab"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
