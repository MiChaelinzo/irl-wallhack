# Raspberry Pi autostart example (UNVERIFIED on hardware).
# Copy to /etc/systemd/system/wallhack.service, adjust User and paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now wallhack
[Unit]
Description=Wallhack WiFi sensing dashboard (localhost only)
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/irl-wallhack
ExecStart=/home/pi/irl-wallhack/.venv/bin/python -m wallhack
Restart=on-failure

[Install]
WantedBy=multi-user.target
